class LRUCache {

    static class Pair {
        Integer key, value;
        Pair(Integer a, Integer b) {
            this.key = a;
            this.value = b;
        }

        Integer getKey() {
            return key;
        }

        Integer getValue() {
            return value;
        }
    }

    ArrayList<Pair> lru = new ArrayList<>();
    int n = 0;

    public LRUCache(int capacity) {
        n = capacity;
    }

    public int get(int key) {
        for (int i = 0; i < lru.size(); i++) {
            Pair pair = lru.get(i);
            if (pair.getKey() == key) {
                lru.remove(i);
                lru.add(pair);
                return pair.getValue();
            }
        }
        return -1;
    }

    public void put(int key, int value) {
        Pair pair = new Pair(key, value);
        for(int i = 0; i < lru.size(); i++) {
            Pair p = lru.get(i);
            if (p.getKey() == key) {
                lru.remove(i);
                lru.add(pair);
                return;
            }
        }
        if (lru.size() == n) {
            lru.remove(0);
        }
        lru.add(pair);
    }
}

