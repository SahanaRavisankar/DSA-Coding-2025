class DLL {
    static class Node {
        int val;
        int key;
        Node prev;
        Node next;

        Node(int k, int v) {
            this.val = v;
            this.key = k;
        }
    }

    Node head;
    Node tail;

    void pushFront(Node curr) {
        if (head == null) {
            head = curr;
            tail = curr;
        } else {
            curr.next = head;
            head.prev = curr;
            head = curr;
        }
    }

    void popFront() {
        if (head == null)
            return;
        if (tail == head) {
            tail = null;
            head = null;
            return;
        }
        head = head.next;
        head.prev = null;
    }

    void remove(Node rem) {
        if (rem == null)
            return;

        if (rem == head) {
            popFront();
        } else if (rem == tail) {
            popBack();
        } else {
            Node pre = rem.prev;
            Node post = rem.next;
            pre.next = post;
            post.prev = pre;
            rem.prev = null;
            rem.next = null;
        }
    }

    void popBack() {
        if (tail == null)
            return;
        if (tail == head) {
            tail = null;
            head = null;
            return;
        }
        Node pre = tail.prev;
        pre.next = null;
        tail = pre;
    }
}

class LRUCache {
    HashMap<Integer, DLL.Node> lru = new HashMap<>();
    int n;
    DLL list;

    public LRUCache(int capacity) {
        n = capacity;
        list = new DLL();
    }

    public void makeRecent(int key) {
        DLL.Node node = lru.get(key);
        list.remove(node);
        list.pushFront(node);
    }

    public int get(int key) {
        if (!lru.containsKey(key))
            return -1;
        makeRecent(key);
        return lru.get(key).val;
    }

    public void put(int key, int value) {
        if (!lru.containsKey(key)) {
            if (lru.size() == n) {
                lru.remove(list.tail.key);
                list.popBack();
            }
            DLL.Node node = new DLL.Node(key, value);
            list.pushFront(node);
            lru.put(key, node);
        } else {
            DLL.Node node = lru.get(key);
            node.val = value;
            makeRecent(key);
        }
    }
}

